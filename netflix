  { id: 15, title: "Campus Stories",    cat: "Comedy",   year: 2025, rating: "13+", genre: "Comedy",   desc: "Freshers, friends, and fiascos on an engineering college campus.",         gradient: "linear-gradient(135deg,#ee0979,#ff6a00)" }
];
 
const categories = ["Trending", "Top Rated", "Action", "Comedy"];
 
// ---------- STATE ----------
let myList = JSON.parse(localStorage.getItem("myList") || "[]");
let currentMovie = null;
let heroIndex = 0;
 
// ---------- ELEMENTS ----------
const rowsEl     = document.getElementById("rows");
const navbar     = document.getElementById("navbar");
const searchBox  = document.getElementById("searchBox");
const hero       = document.getElementById("hero");
const modal      = document.getElementById("modal");
 
// ---------- RENDER ROWS ----------
function renderRows(list = movies, showMyList = false) {
  rowsEl.innerHTML = "";
 
  if (showMyList) {
    const mine = movies.filter(m => myList.includes(m.id));
    rowsEl.appendChild(createRow("My List", mine));
    return;
  }
 
  categories.forEach(cat => {
    const items = list.filter(m => m.cat === cat);
    if (items.length) rowsEl.appendChild(createRow(cat, items));
  });
 
  if (!rowsEl.children.length) {
    rowsEl.innerHTML = "<p style='padding:60px 4%;color:#b3b3b3'>No titles found.</p>";
  }
}
 
function createRow(title, items) {
  const row = document.createElement("section");
  row.className = "row";
  row.innerHTML = `
    <h3>${title}</h3>
    <div class="row-wrap">
      <button class="arrow left">&#8249;</button>
      <div class="row-posters"></div>
      <button class="arrow right">&#8250;</button>
    </div>`;
 
  const posters = row.querySelector(".row-posters");
  if (!items.length) posters.innerHTML = "<p style='color:#b3b3b3'>Nothing here yet.</p>";
 
  items.forEach(m => {
    const card = document.createElement("div");
    card.className = "poster";
    card.style.background = m.gradient;
    card.textContent = m.title;
    card.addEventListener("click", () => openModal(m));
    posters.appendChild(card);
  });
 
  row.querySelector(".arrow.left").onclick  = () => posters.scrollBy({ left: -600 });
  row.querySelector(".arrow.right").onclick = () => posters.scrollBy({ left:  600 });
  return row;
}
 
// ---------- HERO ----------
function setHero(index) {
  const m = movies[index];
  hero.style.background =
    `linear-gradient(to right, rgba(0,0,0,0.75), transparent), ${m.gradient}`;
  document.getElementById("heroTitle").textContent = m.title;
  document.getElementById("heroDesc").textContent  = m.desc;
  document.getElementById("heroInfo").onclick = () => openModal(m);
}
 
setInterval(() => {
  heroIndex = (heroIndex + 1) % 5;   // rotate through first 5 titles
  setHero(heroIndex);
}, 7000);
 
// ---------- MODAL ----------
function openModal(m) {
  currentMovie = m;
  document.getElementById("modalBanner").style.background = m.gradient;
  document.getElementById("modalTitle").textContent = m.title;
  document.getElementById("modalMeta").textContent  = `${m.year}  |  ${m.rating}  |  ${m.genre}`;
  document.getElementById("modalDesc").textContent  = m.desc;
  updateListButton();
  modal.classList.add("open");
}
 
function closeModal() { modal.classList.remove("open"); }
 
function updateListButton() {
  const btn = document.getElementById("modalList");
  btn.textContent = myList.includes(currentMovie.id) ? "\u2713 In My List" : "+ My List";
}
 
document.getElementById("modalClose").onclick = closeModal;
modal.addEventListener("click", e => { if (e.target === modal) closeModal(); });
document.addEventListener("keydown", e => { if (e.key === "Escape") closeModal(); });
 
document.getElementById("modalList").onclick = () => {
  const id = currentMovie.id;
  myList = myList.includes(id) ? myList.filter(x => x !== id) : [...myList, id];
  localStorage.setItem("myList", JSON.stringify(myList));
  updateListButton();
};
 
// ---------- SEARCH ----------
searchBox.addEventListener("input", () => {
  const q = searchBox.value.trim().toLowerCase();
  const result = movies.filter(m =>
    m.title.toLowerCase().includes(q) || m.genre.toLowerCase().includes(q)
  );
  renderRows(result);
});
 
// ---------- NAV ----------
window.addEventListener("scroll", () => {
  navbar.classList.toggle("scrolled", window.scrollY > 60);
});
 
document.querySelectorAll(".nav-links li").forEach(li => {
  li.addEventListener("click", () => {
    document.querySelectorAll(".nav-links li").forEach(x => x.classList.remove("active"));
    li.classList.add("active");
    renderRows(movies, li.id === "myListLink");
  });
});
 
// ---------- INIT ----------
setHero(0);
renderRows();
 

