4. style.css
Dark theme, Netflix red accents, flexbox rows, hover animations and a mobile media query.
/* ---------- RESET & BASE ---------- */
* { margin: 0; padding: 0; box-sizing: border-box; }
 
:root {
  --red: #e50914;
  --black: #141414;
  --white: #ffffff;
  --grey: #b3b3b3;
}
 
body {
  background: var(--black);
  color: var(--white);
  font-family: "Helvetica Neue", Arial, sans-serif;
  overflow-x: hidden;
}
 
/* ---------- NAVBAR ---------- */
.navbar {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 100;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18px 4%;
  background: linear-gradient(to bottom, rgba(0,0,0,0.85), transparent);
  transition: background 0.4s;
}
.navbar.scrolled { background: var(--black); }
 
.nav-left, .nav-right { display: flex; align-items: center; gap: 25px; }
 
.logo {
  color: var(--red);
  font-size: 1.9rem;
  font-weight: 900;
  letter-spacing: 2px;
}
 
.nav-links { display: flex; gap: 20px; list-style: none; }
.nav-links li {
  font-size: 0.9rem;
  color: #e5e5e5;
  cursor: pointer;
  transition: color 0.3s;
}
.nav-links li:hover, .nav-links li.active { color: var(--grey); font-weight: 600; }
 
#searchBox {
  background: rgba(0,0,0,0.6);
  border: 1px solid #777;
  color: var(--white);
  padding: 7px 12px;
  border-radius: 3px;
  outline: none;
  width: 190px;
}
#searchBox:focus { border-color: var(--white); }
 
.avatar {
  width: 34px; height: 34px;
  border-radius: 4px;
  background: #0077ff;
  display: grid;
  place-items: center;
  font-weight: bold;
}
 
/* ---------- HERO ---------- */
.hero {
  position: relative;
  height: 90vh;
  display: flex;
  align-items: center;
  padding: 0 4%;
  background-size: cover;
  background-position: center;
  transition: background 0.8s;
}
.hero-content { max-width: 560px; z-index: 2; }
.hero-content h2 {
  font-size: 3.8rem;
  margin-bottom: 15px;
  text-shadow: 2px 2px 8px rgba(0,0,0,0.7);
}
.hero-content p {
  font-size: 1.15rem;
  line-height: 1.5;
  margin-bottom: 22px;
  text-shadow: 1px 1px 4px rgba(0,0,0,0.8);
}
.hero-fade {
  position: absolute;
  bottom: 0; left: 0; right: 0;
  height: 180px;
  background: linear-gradient(to top, var(--black), transparent);
}
 
.hero-buttons { display: flex; gap: 12px; }
.btn {
  border: none;
  border-radius: 4px;
  padding: 11px 26px;
  font-size: 1.05rem;
  font-weight: 700;
  cursor: pointer;
  transition: opacity 0.25s;
}
.btn:hover { opacity: 0.75; }
.btn-play { background: var(--white); color: #000; }
.btn-info { background: rgba(109,109,110,0.7); color: var(--white); }
 
/* ---------- ROWS ---------- */
#rows { margin-top: -90px; position: relative; z-index: 5; padding-bottom: 40px; }
.row { padding: 0 4%; margin-bottom: 34px; position: relative; }
.row h3 { font-size: 1.35rem; margin-bottom: 12px; }
 
.row-wrap { position: relative; }
.row-posters {
  display: flex;
  gap: 8px;
  overflow-x: auto;
  scroll-behavior: smooth;
  padding: 10px 0;
  scrollbar-width: none;
}
.row-posters::-webkit-scrollbar { display: none; }
 
.poster {
  flex: 0 0 auto;
  width: 230px;
  height: 130px;
  border-radius: 5px;
  display: flex;
  align-items: flex-end;
  padding: 10px;
  font-weight: 700;
  cursor: pointer;
  transition: transform 0.3s, box-shadow 0.3s;
  text-shadow: 1px 1px 4px #000;
}
.poster:hover {
  transform: scale(1.12);
  z-index: 10;
  box-shadow: 0 8px 25px rgba(0,0,0,0.8);
}
 
.arrow {
  position: absolute;
  top: 10px; bottom: 10px;
  width: 45px;
  border: none;
  background: rgba(20,20,20,0.6);
  color: var(--white);
  font-size: 2rem;
  cursor: pointer;
  opacity: 0;
  transition: opacity 0.3s;
  z-index: 20;
}
.row-wrap:hover .arrow { opacity: 1; }
.arrow.left { left: -4%; }
.arrow.right { right: -4%; }
 
/* ---------- MODAL ---------- */
.modal {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.75);
  display: none;
  justify-content: center;
  align-items: center;
  z-index: 200;
}
.modal.open { display: flex; }
.modal-box {
  width: min(720px, 92%);
  background: #181818;
  border-radius: 8px;
  overflow: hidden;
  position: relative;
  animation: pop 0.3s ease;
}
@keyframes pop { from { transform: scale(0.9); opacity: 0; } to { transform: scale(1); opacity: 1; } }
.modal-close {
  position: absolute;
  top: 10px; right: 16px;
  font-size: 2rem;
  cursor: pointer;
  z-index: 3;
}
.modal-banner { height: 300px; }
.modal-body { padding: 24px; }
.modal-body h2 { margin-bottom: 8px; }
.meta { color: #46d369; font-weight: 600; margin-bottom: 12px; }
.modal-body p { line-height: 1.55; margin-bottom: 18px; }
 
/* ---------- FOOTER ---------- */
.footer {
  text-align: center;
  color: var(--grey);
  padding: 40px 4%;
  font-size: 0.85rem;
  line-height: 1.8;
}
 
/* ---------- RESPONSIVE ---------- */
@media (max-width: 768px) {
  .nav-links { display: none; }
  .hero-content h2 { font-size: 2.3rem; }
  .poster { width: 160px; height: 95px; font-size: 0.8rem; }
  #searchBox { width: 120px; }
}
 
